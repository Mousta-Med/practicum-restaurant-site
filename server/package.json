{
  "name": "olive-and-ember-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "db:schema": "node --env-file=.env db/apply-schema.js",
    "db:auth": "node --env-file=.env db/migrate-auth.js",
    "db:seed": "node --env-file=.env db/seed.js"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
