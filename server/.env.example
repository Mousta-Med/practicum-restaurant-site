# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string (Neon dashboard > Connect), ending in sslmode=verify-full
DATABASE_URL=

# Random secret that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The address people open in the browser: http://localhost:5173 locally,
# your Vercel URL in production
BETTER_AUTH_URL=http://localhost:5173
